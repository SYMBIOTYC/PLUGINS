{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amphetamin-mcp",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-28",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "TENANT_ID": "symbiotyc",
    "PROJECT_ID": "compute",
    "ACTOR_ID": "symbiotyc-cloud-assistant",
    "MCP_ALLOWED_ORIGINS": ""
  },
  "services": [
    {
      "binding": "GROUP",
      "service": "symbiotyc-group-control-plane",
      "environment": "production"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
      "persist": true
    }
  }
}
